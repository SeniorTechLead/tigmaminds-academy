# Hackathon organizer notify address: src/data/hackathon.json → notifyEmail

# Qualifying round: team verify / OTP / upload use src/services/hackathon.ts

############################################################
# EMAIL PROVIDER (pick one: azure | resend | gmail | outlook | smtp)
############################################################
EMAIL_PROVIDER=azure

############################################################
# [1] AZURE / Microsoft Graph — use when EMAIL_PROVIDER=azure
# App registration needs Mail.Send (Application) + admin consent
############################################################
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your_azure_client_secret
SENDER_EMAIL=web@tigmaminds.com
EMAIL_FROM=web@tigmaminds.com
# Shown as the From name. For Azure/Outlook, also set this mailbox's
# Display Name in Microsoft 365 admin (Users → SENDER_EMAIL), or grant
# the app User.ReadWrite.All so it can sync automatically.
EMAIL_FROM_NAME=TigmaMinds Academy

############################################################
# [2] GMAIL  — use when EMAIL_PROVIDER=gmail
# App password: https://myaccount.google.com/apppasswords
############################################################
# EMAIL_FROM=you@gmail.com
# EMAIL_FROM_NAME=TigmaMinds Academy
# EMAIL_SMTP_USER=you@gmail.com
# EMAIL_SMTP_PASSWORD=xxxxxxxxxxxxxxxx

############################################################
# [3] RESEND — use when EMAIL_PROVIDER=resend
############################################################
# EMAIL_FROM=noreply@tigmaminds.academy
# EMAIL_FROM_NAME=TigmaMinds Academy
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

############################################################
# [4] OUTLOOK — use when EMAIL_PROVIDER=outlook
############################################################
# EMAIL_FROM=you@outlook.com
# EMAIL_FROM_NAME=TigmaMinds Academy
# EMAIL_SMTP_USER=you@outlook.com
# EMAIL_SMTP_PASSWORD=dummyOutlookPassword

############################################################
# [5] SMTP   — use when EMAIL_PROVIDER=smtp
############################################################
